{
  "name": "dsh-antigravity",
  "version": "0.0.9",
  "description": "Google Antigravity / Cloud Code Assist model provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.3.0",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.2.0-rc.1": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "bin": {
    "antigravity-login": "bin/antigravity-login.mjs"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check bin/antigravity-login.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dist": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && npm pack --pack-destination dist"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "antigravity",
    "google",
    "cloud-code-assist",
    "oauth",
    "llm",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyangzhou/dsh-antigravity.git"
  },
  "homepage": "https://github.com/yyangzhou/dsh-antigravity#readme",
  "bugs": {
    "url": "https://github.com/yyangzhou/dsh-antigravity/issues"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1"
  }
}
